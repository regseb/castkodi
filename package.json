{
  "name": "castkodi",
  "version": "7.19.0",
  "description": "WebExtension pour diffuser des vidéos et des musiques sur Kodi.",
  "keywords": [
    "cast",
    "kodi",
    "webextension",
    "chrome",
    "firefox",
    "youtube",
    "twitch",
    "vimeo",
    "soundcloud"
  ],
  "homepage": "https://github.com/regseb/castkodi#readme",
  "bugs": {
    "url": "https://github.com/regseb/castkodi/issues",
    "email": "regseb@gmail.com"
  },
  "license": "MIT",
  "author": "Sébastien Règne <regseb@gmail.com> (https://github.com/regseb)",
  "funding": [
    "https://buymeacoffee.com/regseb",
    "https://www.paypal.me/sebastienregne"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regseb/castkodi.git"
  },
  "type": "module",
  "scripts": {
    "postinstall": "node .script/sync.js",
    "lint": "metalint",
    "lint:fix": "metalint --fix",
    "lint:types": "tsc --project .tsconfig_lint.json",
    "test": "npm run test:coverage",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency 1 \"test/integration/**/*.test.js\"",
    "test:fuzz": "node --test \"test/fuzz/**/*.test.js\"",
    "test:coverage": "stryker run",
    "jsdocs": "typedoc --tsconfig .tsconfig_jsdocs.json",
    "start:chromium": "web-ext run --source-dir src/ --target chromium",
    "start:firefox": "web-ext run --source-dir src/ --target firefox-desktop",
    "start:firefox-android": "web-ext run --source-dir src/ --target firefox-android --firefox-apk org.mozilla.fenix",
    "build": "node .script/build.js",
    "clean": "node .script/clean.js"
  },
  "dependencies": {
    "linkedom": "0.18.13"
  },
  "devDependencies": {
    "@biomejs/js-api": "6.0.0",
    "@biomejs/wasm-nodejs": "2.5.15",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@prantlf/jsonlint": "17.0.1",
    "@prettier/plugin-xml": "3.4.2",
    "@secretlint/secretlint-rule-github": "13.0.7",
    "@secretlint/secretlint-rule-npm": "13.0.7",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/tap-runner": "10.0.0",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "26.6.5",
    "@typescript-eslint/utils": "8.71.2",
    "addons-linter": "10.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-array-func": "5.1.1",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.3.8",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-unicorn": "78.0.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "htmlhint": "1.9.0",
    "markdownlint": "0.42.0",
    "metalint": "0.22.1",
    "msw": "3.0.3",
    "npm-package-json-lint": "11.0.0",
    "prettier": "3.9.10",
    "purgecss": "8.0.0",
    "secretlint": "13.0.7",
    "stylelint": "17.16.0",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-order": "8.1.2",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "urlpattern-polyfill": "10.1.0",
    "web-ext": "10.8.0",
    "yaml-lint": "1.7.0"
  },
  "engines": {
    "node": ">=26.5.1"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "private": true
}
